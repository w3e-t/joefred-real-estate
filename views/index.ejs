              <optgroup label="Building Materials">
                <option value="Cement Supply">Cement</option>
                <option value="Iron Rods Supply">Iron Rods</option>
                <option value="Building Blocks">Building Blocks</option>
                <option value="Timber and Wood">Timber & Wood</option>
                <option value="Roofing Sheets">Roofing Sheets</option>
